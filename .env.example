# Copy this file to .env and update the values
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/shp_organics

# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed demo buyer/seller accounts on startup (true/false)
SEED_DEMO_USERS=false
